<?xml version="1.0" encoding="UTF-8"?>
<!-- NSIS is a non-composite PE: payloads are signed before packaging. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Syndocal_${version}_x64-setup.exe" product-name="Syndocal" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
