{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syndocal.invalid/schemas/release-evidence-manifest-v2.json",
  "title": "Syndocal release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productVersion",
    "tag",
    "commit",
    "previousVersion",
    "previousTag",
    "updater",
    "artifacts",
    "windowsSigning"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "productVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[1-9][0-9]*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[1-9][0-9]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "previousVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "previousTag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "updater": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "endpoint",
        "manifestPath",
        "manifestSha256",
        "publicKeyPath",
        "publicKeyFingerprint"
      ],
      "properties": {
        "channel": {
          "enum": [
            "stable",
            "beta",
            "nightly"
          ]
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "minLength": 12
        },
        "manifestPath": {
          "type": "string",
          "pattern": "^[^:\\u0000]{1,240}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "publicKeyPath": {
          "type": "string",
          "pattern": "^[^:\\u0000]{1,240}$"
        },
        "publicKeyFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "target",
          "filename",
          "path",
          "sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "windows-executable",
              "updater-payload",
              "installer",
              "disk-image",
              "appimage"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "filename": {
            "type": "string",
            "pattern": "^[^/\\\\]{1,180}$"
          },
          "path": {
            "type": "string",
            "pattern": "^[^:\\u0000]{1,240}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "signaturePath": {
            "type": "string",
            "pattern": "^[^:\\u0000]{1,240}$"
          },
          "signatureSha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "updater-payload"
                }
              }
            },
            "then": {
              "properties": {
                "signaturePath": {},
                "signatureSha256": {}
              },
              "required": [
                "signaturePath",
                "signatureSha256"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "signaturePath"
                    ]
                  },
                  {
                    "required": [
                      "signatureSha256"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "windowsSigning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "state",
        "unsignedReason",
        "signpath",
        "components"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "state": {
          "enum": [
            "signpath-signed",
            "declared-unsigned"
          ]
        },
        "unsignedReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "signpath": {
          "type": [
            "object",
            "null"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "ownership",
              "authenticode",
              "certificateThumbprint"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ownership": {
                "enum": [
                  "project",
                  "upstream"
                ]
              },
              "authenticode": {
                "enum": [
                  "valid",
                  "not-signed"
                ]
              },
              "certificateThumbprint": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
