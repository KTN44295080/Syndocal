+"""Cold, read-only validation of bounded diagnostic capture; never a C5 gate."""
+import json
+import pathlib
+
+
+def nat(v):
+    return isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 0xffffffffffffffff
+
+
+def validate_capture(data):
+    errors = []
+    if not isinstance(data, dict):
+        return ['capture is not an object']
+    if data.get('schema') != 'native-work-spikes-1' or data.get('diagnostic_only') is not True:
+        errors.append('unrecognized diagnostic schema')
+    for key in ('generation', 'start_monotonic_us', 'start_unix_us', 'clock_calibration_uncertainty_us', 'stop_us', 'unprepared_frames'):
+        if not nat(data.get(key)):
+            errors.append('invalid ' + key)
+    if data.get('unprepared_frames') != 0:
+        errors.append('unprepared frames')
+    s = data.get('samples')
+    if not isinstance(s, dict):
+        return errors + ['missing samples']
+    if not nat(s.get('generation')) or s.get('generation') != data.get('generation') or not nat(data.get('generation')) or data['generation'] == 0:
+        errors.append('generation mismatch')
+    if not nat(s.get('retained_bytes')) or not 0 < s['retained_bytes'] <= 16384:
+        errors.append('retained-byte bound')
+    if not nat(s.get('record_capacity')) or not nat(s.get('work_threshold_us')) or s.get('record_capacity') != 16 or s.get('work_threshold_us') != 33333:
+        errors.append('capacity/threshold mismatch')
+    if s.get('retired') is not True or s.get('current_iteration') is not None or s.get('unfinished_iteration') is not None:
+        errors.append('owner did not retire completely')
+    c = s.get('counters')
+    keys = ('attempted_iterations', 'completed_iterations', 'excluded_count', 'fast_count', 'matched_count',
+            'partial_count', 'unobserved_count', 'overflow_count', 'invalid_count', 'incomplete_count')
+    if not isinstance(c, dict) or not all(nat(c.get(k)) for k in keys):
+        return errors + ['missing/malformed counters']
+    if not c['attempted_iterations'] or c['attempted_iterations'] != c['completed_iterations']:
+        errors.append('incomplete iteration coverage')
+    if any(c[k] for k in ('partial_count', 'unobserved_count', 'invalid_count', 'incomplete_count')):
+        errors.append('partial or invalid diagnostic observations')
+    if c['completed_iterations'] != c['excluded_count'] + c['fast_count'] + c['matched_count']:
+        errors.append('iteration accounting mismatch')
+    records = s.get('records')
+    if not isinstance(records, list):
+        return errors + ['missing records']
+    if len(records) != min(c['matched_count'], 16) or c['overflow_count'] != c['matched_count'] - len(records):
+        errors.append('retention accounting mismatch')
+    last_iteration = last_work = 0
+    fields = ('iteration', 'output_id', 'last_presented_request_sequence', 'frames_presented', 'work_sample_sequence',
+              'validation_epoch', 'start_us', 'sample_us', 'work_us', 'pacing_us', 'extent_us', 'permit_us',
+              'retirement_configure_us', 'prepare_us', 'present_with_pacing_us', 'metrics_lock_wait_us')
+    for r in records:
+        if not isinstance(r, dict) or not all(nat(r.get(k)) for k in fields):
+            errors.append('malformed slow record'); continue
+        if r.get('admitted') is not True or r.get('work_observed') is not True or r.get('partial') is not False or r['work_us'] <= 33333:
+            errors.append('record is not an admitted slow work sample')
+        if not last_iteration < r['iteration'] <= c['attempted_iterations'] or not last_work < r['work_sample_sequence']:
+            errors.append('non-monotonic sample identity')
+        last_iteration, last_work = r['iteration'], r['work_sample_sequence']
+        # Stop closes admission; an already admitted frame may finish afterwards.
+        # ACK/owner retirement proves completion, without inventing an ACK clock.
+        if not nat(data.get('stop_us')) or r['start_us'] > data['stop_us'] or r['sample_us'] < r['start_us']:
+            errors.append('invalid work boundary')
+        if r['present_with_pacing_us'] < r['pacing_us']:
+            errors.append('pacing exceeds enclosing present interval')
+        if abs((r['sample_us'] - r['start_us']) - (r['work_us'] + r['pacing_us'])) > 2:
+            errors.append('work boundary does not share the metric clock')
+    return errors
+
+
+def analyze(run_dir, mode, sessions):
+    run_dir = pathlib.Path(run_dir)
+    errors = []
+    report = {'mode': mode, 'diagnostic_only': True, 'ok': False, 'errors': errors, 'captures': []}
+    if mode not in ('on', 'off') or len(sessions) != 1:
+        errors.append('one explicit diagnostic on/off session required'); return report
+    for session in sessions:
+        sdir = run_dir / session['session']
+        output = sdir / 'frame-spikes.json'
+        try:
+            launch = json.loads((sdir / 'launch.json').read_text(encoding='utf-8'))
+            expected = str(output.resolve()) if mode == 'on' else None
+            if not {'frameSpikeOut', 'frameTimingOut', 'nativeGpuEnv'}.issubset(launch) or launch.get('frameSpikeOut') != expected or launch.get('frameTimingOut') is not None or launch.get('nativeGpuEnv') != '1':
+                errors.append('launch environment mismatch')
+            if mode == 'off':
+                if output.exists(): errors.append('OFF control unexpectedly wrote a capture')
+                continue
+            data = json.loads(output.read_text(encoding='utf-8'))
+            errors.extend(validate_capture(data))
+            if isinstance(data, dict) and isinstance(data.get('samples'), dict):
+                report['captures'].append({'file': str(output), 'data': data})
+        except (OSError, ValueError, TypeError) as e:
+            errors.append('capture unavailable: ' + str(e))
+    report['ok'] = not errors
