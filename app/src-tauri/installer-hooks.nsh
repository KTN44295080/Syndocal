!include TextFunc.nsh
; Bundled extension choices; schema independent of project data.
Var SyndocalDjLinkCheckbox
Var SyndocalDjLinkChoice
Var SyndocalExtensionDir

!macro SYNDOCAL_EXTENSIONS_PAGE
Page custom SyndocalExtensionsPage SyndocalExtensionsLeave
Function SyndocalExtensionsPage
  Call SkipIfPassive
  nsDialogs::Create 1018
  Pop $R0
  ${If} $R0 == error
    Abort
  ${EndIf}
  !insertmacro MUI_HEADER_TEXT "Extensions / 拡張機能" "Choose integrations / 使用する拡張を選択"
  ${NSD_CreateLabel} 0 0 100% 35u "DMX, video and MIDI are included.$\r$\nDMX・映像・MIDIは本体に含まれます。"
  Pop $R1
  ${NSD_CreateCheckbox} 0 45u 100% 20u "DJ Link (DJ computer integration / DJ用PCとの連携)"
  Pop $SyndocalDjLinkCheckbox
  ${NSD_SetState} $SyndocalDjLinkCheckbox $SyndocalDjLinkChoice
  nsDialogs::Show
FunctionEnd
Function SyndocalExtensionsLeave
  ${NSD_GetState} $SyndocalDjLinkCheckbox $SyndocalDjLinkChoice
FunctionEnd
Function SyndocalExtensionsInit
  ; The choice is per user even when installer shell context is all users.
  ReadEnvStr $SyndocalExtensionDir "LOCALAPPDATA"
  StrCmp $SyndocalExtensionDir "" SyndocalExtensionsInvalid
  StrCpy $SyndocalExtensionDir "$SyndocalExtensionDir\${BUNDLEID}"
  StrCpy $SyndocalDjLinkChoice 0
  IfFileExists "$SyndocalExtensionDir\extensions.ini" 0 SyndocalExtensionsInitDone
  ClearErrors
  FileOpen $R7 "$SyndocalExtensionDir\extensions.ini" r
  IfErrors SyndocalExtensionsInvalid
  FileRead $R7 $R8
  ${TrimNewLines} $R8 $R8
  StrCmp $R8 "[SyndocalExtensions]" 0 SyndocalExtensionsInvalidClose
  FileRead $R7 $R8
  ${TrimNewLines} $R8 $R8
  StrCmp $R8 "Schema=1" 0 SyndocalExtensionsInvalidClose
  FileRead $R7 $R8
  ${TrimNewLines} $R8 $R8
  StrCmp $R8 "DJLink=0" SyndocalExtensionsCore
  StrCmp $R8 "DJLink=1" SyndocalExtensionsDjLink SyndocalExtensionsInvalidClose
  SyndocalExtensionsCore:
  StrCpy $SyndocalDjLinkChoice 0
  Goto SyndocalExtensionsEndCheck
  SyndocalExtensionsDjLink:
  StrCpy $SyndocalDjLinkChoice 1
  SyndocalExtensionsEndCheck:
  ClearErrors
  FileRead $R7 $R8
  IfErrors SyndocalExtensionsValidClose
  ${TrimNewLines} $R8 $R8
  StrCmp $R8 "" SyndocalExtensionsEndCheck SyndocalExtensionsInvalidClose
  SyndocalExtensionsValidClose:
  FileClose $R7
  Goto SyndocalExtensionsInitDone
  SyndocalExtensionsInvalidClose:
  FileClose $R7
  SyndocalExtensionsInvalid:
  MessageBox MB_ICONSTOP|MB_OK "Invalid or unsupported extension settings. Preserve extensions.ini and install a compatible version." /SD IDOK
  SetErrorLevel 1
  Abort
  SyndocalExtensionsInitDone:

  ClearErrors
  ${GetOptions} $CMDLINE "/DJLINK=" $R8
  ${IfNot} ${Errors}
    ${If} $R8 != "0"
    ${AndIf} $R8 != "1"
      MessageBox MB_ICONSTOP|MB_OK "Use /DJLINK=0 or /DJLINK=1." /SD IDOK
      SetErrorLevel 1
      Abort
    ${EndIf}
    StrCpy $SyndocalDjLinkChoice $R8
  ${EndIf}
FunctionEnd
!macroend

!macro NSIS_HOOK_POSTINSTALL
  CreateDirectory "$SyndocalExtensionDir"
  ClearErrors
  FileOpen $R8 "$SyndocalExtensionDir\extensions.ini.pending" w
  ${If} ${Errors}
    MessageBox MB_ICONSTOP|MB_OK "Extension settings could not be written." /SD IDOK
    SetErrorLevel 1
    Abort
  ${EndIf}
  FileWrite $R8 "[SyndocalExtensions]$\r$\nSchema=1$\r$\nDJLink=$SyndocalDjLinkChoice$\r$\n"
  ${If} ${Errors}
    FileClose $R8
    Delete "$SyndocalExtensionDir\extensions.ini.pending"
    MessageBox MB_ICONSTOP|MB_OK "Extension settings could not be written." /SD IDOK
    SetErrorLevel 1
    Abort
  ${EndIf}
  FileClose $R8
  System::Call 'kernel32::MoveFileExW(w "$SyndocalExtensionDir\extensions.ini.pending", w "$SyndocalExtensionDir\extensions.ini", i 1)i.rR8'
  ${If} $R8 == 0
    MessageBox MB_ICONSTOP|MB_OK "Extension settings could not be saved. Installation cannot continue." /SD IDOK
    SetErrorLevel 1
    Abort
  ${EndIf}
!macroend
; Generated by tools/distribution/generate-installer-hooks.mjs. No installed helper payload.
!macro SYNDOCAL_DATA_CLEANUP VALIDATE
  InitPluginsDir
  FileOpen $R8 "$PLUGINSDIR\syndocal-cleanup.ps1" w
  FileWrite $R8 "param([switch]$$ValidateOnly)$\r$\n"
  FileWrite $R8 "$$ErrorActionPreference = 'Stop'$\r$\n"
  FileWrite $R8 "# The installer removes binaries, associations and shortcuts. This opt-in tool$\r$\n"
  FileWrite $R8 "# removes only this user's product-owned state; never external .sdc/media files.$\r$\n"
  FileWrite $R8 "if (Get-Process -Name syndocal -ErrorAction SilentlyContinue) {$\r$\n"
  FileWrite $R8 "    throw 'Close every Syndocal instance before removing its data.'$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "$$taskTargets = New-Object 'System.Collections.Generic.List[string]'$\r$\n"
  FileWrite $R8 "foreach ($$taskRoot in @($$env:APPDATA, $$env:LOCALAPPDATA)) {$\r$\n"
  FileWrite $R8 "    if (-not $$taskRoot -or -not [IO.Path]::IsPathRooted($$taskRoot)) { throw 'Invalid application data root' }$\r$\n"
  FileWrite $R8 "    $$taskTargets.Add((Join-Path $$taskRoot 'jp.seraf.ktn.syndocal'))$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "if (-not $$env:TEMP -or -not [IO.Path]::IsPathRooted($$env:TEMP)) { throw 'Invalid temporary root' }$\r$\n"
  FileWrite $R8 "$$taskTargets.Add((Join-Path $$env:TEMP 'Syndocal\crash-reports'))$\r$\n"
  FileWrite $R8 "foreach ($$taskEntry in Get-ChildItem -LiteralPath $$env:TEMP -Force) {$\r$\n"
  FileWrite $R8 "    if ($$taskEntry.Name -cmatch '^syndocal-media-snapshot-[0-9]+-[0-9a-f]+-[0-9a-f]+$$' -or$\r$\n"
  FileWrite $R8 "        $$taskEntry.Name -cmatch '^syndocal-gdtf-share-[0-9]+-[0-9]+\.cookies$$') {$\r$\n"
  FileWrite $R8 "        $$taskTargets.Add($$taskEntry.FullName)$\r$\n"
  FileWrite $R8 "    }$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "# Preflight ALL paths before any deletion. Reject junctions/symlinks in the$\r$\n"
  FileWrite $R8 "# target, ancestors, and children instead of following redirected data.$\r$\n"
  FileWrite $R8 "foreach ($$taskTarget in $$taskTargets) {$\r$\n"
  FileWrite $R8 "    $$taskAbsolute = [IO.Path]::GetFullPath($$taskTarget)$\r$\n"
  FileWrite $R8 "    $$taskUnderRoot = $$false$\r$\n"
  FileWrite $R8 "    foreach ($$taskRoot in @($$env:APPDATA, $$env:LOCALAPPDATA, $$env:TEMP)) {$\r$\n"
  FileWrite $R8 "        $$taskPrefix = [IO.Path]::GetFullPath($$taskRoot).TrimEnd('\') + '\'$\r$\n"
  FileWrite $R8 "        if ($$taskAbsolute.StartsWith($$taskPrefix, [StringComparison]::OrdinalIgnoreCase)) { $$taskUnderRoot = $$true }$\r$\n"
  FileWrite $R8 "    }$\r$\n"
  FileWrite $R8 "    if (-not $$taskUnderRoot) { throw 'Cleanup target escaped its root' }$\r$\n"
  FileWrite $R8 "    $$taskCursor = $$taskAbsolute$\r$\n"
  FileWrite $R8 "    while ($$taskCursor) {$\r$\n"
  FileWrite $R8 "        if (Test-Path -LiteralPath $$taskCursor) {$\r$\n"
  FileWrite $R8 "            $$taskItem = Get-Item -LiteralPath $$taskCursor -Force$\r$\n"
  FileWrite $R8 "            if ($$taskItem.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Redirected cleanup path rejected' }$\r$\n"
  FileWrite $R8 "        }$\r$\n"
  FileWrite $R8 "        $$taskCursor = [IO.Path]::GetDirectoryName($$taskCursor)$\r$\n"
  FileWrite $R8 "    }$\r$\n"
  FileWrite $R8 "    if (Test-Path -LiteralPath $$taskAbsolute) {$\r$\n"
  FileWrite $R8 "        foreach ($$taskItem in Get-ChildItem -LiteralPath $$taskAbsolute -Force -Recurse) {$\r$\n"
  FileWrite $R8 "            if ($$taskItem.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Redirected cleanup content rejected' }$\r$\n"
  FileWrite $R8 "        }$\r$\n"
  FileWrite $R8 "    }$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "if ($$ValidateOnly) { Write-Output 'PASS: cleanup paths verified; nothing removed.'; exit 0 }$\r$\n"
  FileWrite $R8 "$\r$\n"
  FileWrite $R8 "# OS credentials are not files inside AppData. Remove only exact owned targets.$\r$\n"
  FileWrite $R8 "Add-Type -TypeDefinition @'$\r$\n"
  FileWrite $R8 "using System;$\r$\n"
  FileWrite $R8 "using System.Runtime.InteropServices;$\r$\n"
  FileWrite $R8 "public static class SyndocalUninstallCredentials {$\r$\n"
  FileWrite $R8 " [StructLayout(LayoutKind.Sequential, CharSet=CharSet.Unicode)]$\r$\n"
  FileWrite $R8 " public struct Credential { public uint Flags; public uint Type; public string TargetName; }$\r$\n"
  FileWrite $R8 " [DllImport($\"advapi32.dll$\", EntryPoint=$\"CredEnumerateW$\", CharSet=CharSet.Unicode, SetLastError=true)]$\r$\n"
  FileWrite $R8 " public static extern bool Enumerate(string filter, uint flags, out uint count, out IntPtr credentials);$\r$\n"
  FileWrite $R8 " [DllImport($\"advapi32.dll$\", EntryPoint=$\"CredDeleteW$\", CharSet=CharSet.Unicode, SetLastError=true)]$\r$\n"
  FileWrite $R8 " public static extern bool Delete(string target, uint type, uint flags);$\r$\n"
  FileWrite $R8 " [DllImport($\"advapi32.dll$\", EntryPoint=$\"CredFree$\")] public static extern void Free(IntPtr buffer);$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "'@$\r$\n"
  FileWrite $R8 "$$taskCredentialNames = New-Object 'System.Collections.Generic.List[string]'$\r$\n"
  FileWrite $R8 "$$taskCredentialNames.Add('jp.seraf.ktn.syndocal/dj-link/v1')$\r$\n"
  FileWrite $R8 "$$taskCredentialNames.Add('jp.seraf.ktn.syndocal/dj-link/v1/rollback')$\r$\n"
  FileWrite $R8 "$$taskCount = [uint32]0; $$taskCredentials = [IntPtr]::Zero$\r$\n"
  FileWrite $R8 "if ([SyndocalUninstallCredentials]::Enumerate('Syndocal/AgentAuthority/v1/*', 0, [ref]$$taskCount, [ref]$$taskCredentials)) {$\r$\n"
  FileWrite $R8 "    try {$\r$\n"
  FileWrite $R8 "        for ($$taskIndex = 0; $$taskIndex -lt $$taskCount; ++$$taskIndex) {$\r$\n"
  FileWrite $R8 "            $$taskPointer = [Runtime.InteropServices.Marshal]::ReadIntPtr($$taskCredentials, $$taskIndex * [IntPtr]::Size)$\r$\n"
  FileWrite $R8 "            $$taskCredential = [Runtime.InteropServices.Marshal]::PtrToStructure($$taskPointer, [type][SyndocalUninstallCredentials+Credential])$\r$\n"
  FileWrite $R8 "            if ($$taskCredential.Type -eq 1 -and $$taskCredential.TargetName -cmatch '^Syndocal/AgentAuthority/v1/[0-9a-f]{64}$$') {$\r$\n"
  FileWrite $R8 "                $$taskCredentialNames.Add($$taskCredential.TargetName)$\r$\n"
  FileWrite $R8 "            }$\r$\n"
  FileWrite $R8 "        }$\r$\n"
  FileWrite $R8 "    } finally { [SyndocalUninstallCredentials]::Free($$taskCredentials) }$\r$\n"
  FileWrite $R8 "} elseif ([Runtime.InteropServices.Marshal]::GetLastWin32Error() -ne 1168) { throw 'Credential enumeration failed' }$\r$\n"
  FileWrite $R8 "foreach ($$taskName in $$taskCredentialNames) {$\r$\n"
  FileWrite $R8 "    if (-not [SyndocalUninstallCredentials]::Delete($$taskName, 1, 0) -and$\r$\n"
  FileWrite $R8 "        [Runtime.InteropServices.Marshal]::GetLastWin32Error() -ne 1168) { throw 'Credential deletion failed' }$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "foreach ($$taskTarget in $$taskTargets) {$\r$\n"
  FileWrite $R8 "    if (Test-Path -LiteralPath $$taskTarget) { Remove-Item -LiteralPath $$taskTarget -Recurse -Force }$\r$\n"
  FileWrite $R8 "    if (Test-Path -LiteralPath $$taskTarget) { throw 'Cleanup did not remove an owned path' }$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "$$taskCrashParent = Join-Path $$env:TEMP 'Syndocal'$\r$\n"
  FileWrite $R8 "if ((Test-Path -LiteralPath $$taskCrashParent -PathType Container) -and$\r$\n"
  FileWrite $R8 "    @(Get-ChildItem -LiteralPath $$taskCrashParent -Force).Count -eq 0) {$\r$\n"
  FileWrite $R8 "    Remove-Item -LiteralPath $$taskCrashParent$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "# Installer preference is product-owned state too. Keep the publisher's$\r$\n"
  FileWrite $R8 "# parent key and every other product; never remove HKLM/shared runtime keys.$\r$\n"
  FileWrite $R8 "$$taskRegistryPreference = 'HKCU:\Software\Seraf() / KTN\Syndocal'$\r$\n"
  FileWrite $R8 "if (Test-Path -LiteralPath $$taskRegistryPreference) {$\r$\n"
  FileWrite $R8 "    Remove-Item -LiteralPath $$taskRegistryPreference -Recurse -Force$\r$\n"
  FileWrite $R8 "}$\r$\n"
  FileWrite $R8 "if (Test-Path -LiteralPath $$taskRegistryPreference) { throw 'Installer preference cleanup failed' }$\r$\n"
  FileWrite $R8 "Write-Output 'Syndocal settings, caches, recovery files and owned credentials removed. External projects/media preserved.'$\r$\n"
  FileClose $R8
  nsExec::ExecToLog '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\syndocal-cleanup.ps1" ${VALIDATE}'
  Pop $R8
  ${If} $R8 != 0
    MessageBox MB_ICONSTOP "Syndocal cleanup failed. Close Syndocal and retry with Remove-SyndocalData.ps1."
    SetErrorLevel 1
    Abort
  ${EndIf}
!macroend
!macro NSIS_HOOK_PREUNINSTALL
  ${If} $DeleteAppDataCheckboxState = 1
  ${AndIf} $UpdateMode <> 1
    !insertmacro SYNDOCAL_DATA_CLEANUP "-ValidateOnly"
  ${EndIf}
!macroend
!macro NSIS_HOOK_POSTUNINSTALL
  ${If} $DeleteAppDataCheckboxState = 1
  ${AndIf} $UpdateMode <> 1
    !insertmacro SYNDOCAL_DATA_CLEANUP ""
  ${EndIf}
!macroend
