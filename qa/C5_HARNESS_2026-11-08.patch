+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+import { invokeMcpLocal, isPresendQueryOverloaded } from './mcp-control.mjs';
+
+const queries = ['query_output_control_authority_v1', 'allocate_output_control_request_id_v1', 'query_output_lease_authority_v1'];
+let calls = 0;
+let rejection;
+const backend = { evaluate: expression => vm.runInNewContext(expression, {
+  window: { __TAURI_INTERNALS__: { invoke: async () => { calls++; if (rejection) throw rejection; return 42; } } },
+}) };
+assert.equal(await invokeMcpLocal(backend, queries[0]), 42);
+const observed = async command => {
+  try { await invokeMcpLocal(backend, command); assert.fail('must reject'); }
+  catch (error) { assert.equal(error.constructor, Error); return error; }
+};
+rejection = { code: 'overloaded', message: 'private diagnostic must not be retained', retryable: true, resnapshot_required: false, credential: 'never retain' };
+for (const command of queries) {
+  const error = await observed(command);
+  assert.equal(isPresendQueryOverloaded(error), true);
+  assert.match(error.message, /"code":"overloaded"/);
+  assert.equal(/private|credential|never retain/.test(error.message), false);
+  assert.deepEqual(Object.keys(error.queryError).sort(), ['code', 'resnapshot_required', 'retryable']);
+}
+assert.equal(isPresendQueryOverloaded(await observed('execute_control_plane')), false);
+for (const value of [
+  { code: 'forbidden', retryable: true, resnapshot_required: false },
+  { code: 'unavailable', retryable: true, resnapshot_required: false },
+  { code: 'internal', retryable: true, resnapshot_required: false },
+  { code: 'overloaded', retryable: false, resnapshot_required: false },
+  { code: 'overloaded', retryable: 'true', resnapshot_required: false },
+  { code: 'overloaded', retryable: true, resnapshot_required: true },
+  { code: 'overloaded', retryable: true },
+  'Overloaded retryable: true',
+]) {
+  rejection = value;
+  assert.equal(isPresendQueryOverloaded(await observed(queries[0])), false);
+}
+assert.equal(isPresendQueryOverloaded(Error(queries[0] + ': Overloaded retryable: true')), false);
+await assert.rejects(invokeMcpLocal({ evaluate: async () => { throw Error('transport failed'); } }, queries[0]), /transport failed/);
+assert.equal(calls, 13, 'each invocation executes once; this adapter performs no retries');
+console.log(JSON.stringify({ selftest: 'PASS', cases: 'real evaluated IPC result mapping; exact three-query whitelist; structured overload only; denied/malformed/transport errors; redaction; no adapter retries' }));
