{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syndocal",
  "version": "1.2.0-alpha.22",
  "identifier": "jp.seraf.ktn.syndocal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "pnpm prepare:runtime-libs",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Syndocal",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Seraf()のKTN",
    "copyright": "Copyright (c) 2026 Seraf()のKTN",
    "category": "Music",
    "shortDescription": "Unified DMX lighting and live video control",
    "longDescription": "Syndocal drives DMX lighting and live video from a shared timeline, cue system, BPM clock, and effect engine.",
    "targets": "all",
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../licenses/FFmpeg-LGPL-3.0.txt": "licenses/FFmpeg-LGPL-3.0.txt",
      "../../licenses/Spout2-BSD-2-Clause.txt": "licenses/Spout2-BSD-2-Clause.txt",
      "../../licenses/bcdec_rs-MIT.txt": "licenses/bcdec_rs-MIT.txt"
    },
    "fileAssociations": [
      {
        "ext": ["sdc"],
        "name": "Syndocal Project",
        "description": "Syndocal show project",
        "role": "Editor",
        "mimeType": "application/x-syndocal-project"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"]
      },
      "wix": {
        "language": "ja-JP"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
