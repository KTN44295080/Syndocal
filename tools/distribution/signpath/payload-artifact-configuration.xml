<?xml version="1.0" encoding="UTF-8"?>
<!-- Only project-owned binaries; never re-sign bundled upstream DLLs. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="syndocal.exe" product-name="Syndocal" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="uninstall.exe" product-name="Syndocal" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
