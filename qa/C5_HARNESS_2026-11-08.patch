+"""Real Windows child-process lifetime and synthetic unknown-state regressions."""
+import importlib.util, json, pathlib, subprocess, sys
+from unittest.mock import patch
+
+D = pathlib.Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('runner', D / 'run-c5.py')
+m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
+checks = []
+
+# Retain the Popen handle after exit, reproducing a queryable dead process
+# object. Its image path may be unavailable although creation time survives.
+p = subprocess.Popen([sys.executable, '-I', '-c', 'pass'])
+try:
+    p.wait(timeout=10)
+    observed = m.process_identity(p.pid)
+    assert observed and observed['wait_result'] == 0 and observed['created']
+    launch = {'pid': p.pid, 'path': sys.executable, 'created': observed['created']}
+    with patch.object(m, 'terminate_exact', side_effect=AssertionError('dead child must not be killed')):
+        result = m.observe_launch_cleanup(launch)
+    assert result['app_exit_observation']['wait_result'] == 0 and 'fallback_terminate' not in result
+    checks.append('real exited child with retained handle is observed signaled and never terminated')
+finally:
+    if p.poll() is None: p.kill(); p.wait(timeout=10)
+
+launch = {'pid': 123, 'path': 'C:\\qa\\syndocal.exe', 'created': 456}
+for wait in (258, 0xffffffff, None):
+    observed = {**launch, 'path': None, 'wait_result': wait}
+    with patch.object(m, 'process_identity', return_value=observed), patch.object(m, 'terminate_exact', return_value={'terminated': False, 'reason': 'identity mismatch'}) as terminate:
+        result = m.observe_launch_cleanup(launch)
+    terminate.assert_called_once_with(123, launch['path'], 456)
+    assert 'fallback_terminate' in result
+checks.append('timeout, failed wait and missing wait proof retain fallback failure even when image path is unavailable')
+for observed in (None, {**launch, 'created': 457, 'wait_result': 258}, {**launch, 'path': None, 'wait_result': 0}):
+    with patch.object(m, 'process_identity', return_value=observed), patch.object(m, 'terminate_exact', side_effect=AssertionError('must not kill')):
+        result = m.observe_launch_cleanup(launch)
+    assert 'fallback_terminate' not in result
+checks.append('gone child, reused PID and positively signaled child never trigger termination')
+
+# Exact launch fencing remains enforced by the existing termination primitive.
+p = subprocess.Popen([sys.executable, '-I', '-c', 'import time; time.sleep(30)'])
+try:
+    observed = m.process_identity(p.pid)
+    assert observed and observed['wait_result'] == 258 and observed['path']
+    bad = m.terminate_exact(p.pid, observed['path'], observed['created'] + 1)
+    assert bad['terminated'] is False and bad['reason'] == 'identity mismatch' and p.poll() is None
+    bad = m.terminate_exact(p.pid, observed['path'] + '.wrong', observed['created'])
+    assert bad['terminated'] is False and bad['reason'] == 'identity mismatch' and p.poll() is None
+    result = m.observe_launch_cleanup(observed)
+    assert result['fallback_terminate']['terminated'] is True and result['fallback_terminate']['exit_observed'] is True
+    p.wait(timeout=10)
+    checks.append('real live child remains protected against wrong path or creation time; exact owned child is terminated and failure receipt retained')
+finally:
+    if p.poll() is None: p.kill(); p.wait(timeout=10)
+
+print(json.dumps({'selftest': 'PASS', 'checks': checks}, indent=2))
