{
  "name": "syndocal",
  "private": true,
  "version": "1.0.0",
  "author": "Seraf()のKTN",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:dmx-addressing": "node scripts/check-dmx-addressing-helpers.mjs",
    "check:clock-display": "node scripts/check-clock-display.mjs",
    "check:chaser-draft": "node scripts/check-chaser-draft.mjs",
    "check:destructive-actions": "node scripts/check-destructive-actions.mjs",
    "check:desktop-window": "node scripts/check-desktop-window-mode.mjs",
    "check:native-window": "node scripts/run-native-window-acceptance.mjs",
    "check:empty-states": "node scripts/check-empty-state-guidance.mjs",
    "check:cue-effect-recall": "node scripts/check-cue-effect-recall.mjs",
    "check:effect-draft": "node scripts/check-effect-draft-helpers.mjs",
    "check:localization": "node scripts/check-localization.mjs",
    "check:auto-vj-viewport": "node scripts/check-viewport-containment.mjs --auto-vj-only",
    "check:audio-reactive-viewport": "node scripts/check-viewport-containment.mjs --audio-reactive-only",
    "check:live-audio": "node scripts/check-live-audio-input.mjs",
    "check:live-audio-viewport": "node scripts/check-viewport-containment.mjs --live-audio-only",
    "check:project-storage": "node scripts/check-project-storage-helpers.mjs",
    "check:release": "node scripts/check-release-metadata.mjs",
    "check:release-ui:browser": "pnpm run check:viewport && pnpm run check:timeline-viewport",
    "check:release-ui": "pnpm run check:desktop-window && pnpm run check:release-ui:browser && pnpm run check:native-window",
    "check:scene-blocks": "node scripts/check-scene-block-helpers.mjs",
    "check:scene-block-hour-viewport": "node scripts/check-viewport-containment.mjs --scene-block-hour-only",
    "check:scene-block-overlap-viewport": "node scripts/check-viewport-containment.mjs --scene-block-overlap-only",
    "check:status": "node scripts/check-status-model.mjs",
    "check:terminology": "node scripts/check-ui-terminology.mjs",
    "check:timeline-automation": "node scripts/check-timeline-automation-helpers.mjs",
    "check:timeline-overlap-clusters": "node scripts/check-timeline-overlap-clusters.mjs",
    "check:timeline-viewport": "node scripts/check-timeline-viewport.mjs && node scripts/check-timeline-overlap-clusters.mjs && node scripts/check-viewport-containment.mjs --scene-block-hour-only && node scripts/check-viewport-containment.mjs --scene-block-overlap-only",
    "check:vj-first-run": "node scripts/check-vj-first-run.mjs",
    "check:virtualization": "node scripts/check-virtualization.mjs",
    "check:large-show-ui": "node scripts/check-viewport-containment.mjs --large-show",
    "check:viewport": "node scripts/check-viewport-containment.mjs",
    "check:vj-first-run-viewport": "node scripts/check-viewport-containment.mjs --vj-empty",
    "prepare:runtime-libs": "node scripts/prepare-release-runtime.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.5.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.5.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0"
  }
}
