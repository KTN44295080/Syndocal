{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syndocal.invalid/schemas/warning-inventory-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "policy", "configurations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineMeaning", "identity", "locationPolicy", "growthPolicy", "requiredMatrixComplete"],
      "properties": {
        "baselineMeaning": { "type": "string", "minLength": 1 },
        "identity": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "locationPolicy": { "type": "string", "minLength": 1 },
        "growthPolicy": { "type": "string", "minLength": 1 },
        "requiredMatrixComplete": { "type": "boolean" }
      }
    },
    "configurations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/configuration" } }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args"],
      "properties": {
        "executable": { "enum": ["cargo", "pnpm"] },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo", "rustc", "node", "pnpm"],
      "properties": {
        "cargo": { "type": "string", "minLength": 1 },
        "rustc": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "capturedAt", "command", "toolchain"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "capturedAt": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "toolchain": { "$ref": "#/$defs/toolchain" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "target", "targetKinds", "crateTypes"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "targetKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "crateTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "profile", "features", "classification", "origin", "package", "target", "targetKinds", "code", "file", "line", "column", "message", "occurrences", "identity", "owner", "reason", "removalCheckpoint"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "classification": { "enum": ["first-party", "third-party"] },
        "origin": { "enum": ["source", "custom-build", "external-source", "no-source"] },
        "package": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "targetKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "code": { "type": ["string", "null"] },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "message": { "type": "string", "minLength": 1 },
        "occurrences": { "type": "integer", "minimum": 1 },
        "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "removalCheckpoint": { "type": "string", "minLength": 1 }
      }
    },
    "externalAllow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "owner", "reason", "upstream", "expiry", "maxOccurrences"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "upstream": { "type": "string", "minLength": 1 },
        "expiry": { "type": "string", "minLength": 1 },
        "maxOccurrences": { "type": "integer", "minimum": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "profile", "features", "command", "timeoutMs", "firstPartyManifests", "status", "expectedArtifacts", "diagnostics", "externalWarningAllows"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "command": { "$ref": "#/$defs/command" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "firstPartyManifests": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "requiredEnvironment": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["enforced", "pending"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "blockingReason": { "type": "string", "minLength": 1 },
        "nextAction": { "type": "string", "minLength": 1 },
        "expectedOutputMarkers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedArtifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "externalWarningAllows": { "type": "array", "items": { "$ref": "#/$defs/externalAllow" } }
      },
      "allOf": [
        {
          "if": {
            "required": ["status", "command"],
            "properties": {
              "status": { "const": "enforced" },
              "command": { "type": "object", "properties": { "executable": { "const": "cargo" } }, "required": ["executable"] }
            }
          },
          "then": { "required": ["evidence"], "properties": { "expectedArtifacts": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": {
            "required": ["status", "command"],
            "properties": {
              "status": { "const": "enforced" },
              "command": { "type": "object", "properties": { "executable": { "const": "pnpm" } }, "required": ["executable"] }
            }
          },
          "then": {
            "required": ["evidence", "expectedOutputMarkers"],
            "properties": {
              "expectedArtifacts": { "type": "array", "maxItems": 0 },
              "diagnostics": { "type": "array", "maxItems": 0 },
              "externalWarningAllows": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
          "then": {
            "required": ["blockingReason", "nextAction"],
            "properties": {
              "expectedArtifacts": { "type": "array", "maxItems": 0 },
              "diagnostics": { "type": "array", "maxItems": 0 },
              "externalWarningAllows": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
